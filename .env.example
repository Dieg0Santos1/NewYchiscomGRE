PORT=3001
NODE_ENV=development
DRY_RUN=true
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=frontend/dist
EXISTING_GRE_API_URL=http://192.168.1.140:92
EXISTING_GRE_API_TOKEN=REEMPLAZAR_SOLO_EN_EL_ARCHIVO_LOCAL_ENV
GRE_REQUEST_TIMEOUT_MS=30000

# Acceso al portal. En produccion debe estar habilitado.
AUTH_ENABLED=false
# Genere un valor con: npm run auth:user -- --secret
AUTH_SESSION_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
AUTH_SESSION_HOURS=12
# true solamente cuando el portal se publica mediante HTTPS.
AUTH_COOKIE_SECURE=false

GRE_REMITENTE_TIPO_DOCUMENTO=6
GRE_REMITENTE_NUMERO_DOCUMENTO=20259402965
GRE_REMITENTE_RAZON_SOCIAL=YCHIFORMAS S.A.
GRE_REMITENTE_CORREO=-
GRE_PARTIDA_UBIGEO=140109
GRE_PARTIDA_DIRECCION=AV. LUNA PIZARRO 1328-1340, LA VICTORIA

# Endpoint experimental de escritura directa. Mantener false salvo prueba controlada.
GRE_DIRECT_DB_INSERT_ENABLED=false

# Pre-guia y guia interna Ychiscom. Mantener false hasta desplegar y validar
# los wrappers dbo.GRE_WEB_* con una prueba controlada.
FC_LEGACY_WRITE_ENABLED=false

# Base propia de control y trazabilidad de formularios continuos
GRE_FC_SQL_SERVER=REEMPLAZAR
GRE_FC_SQL_PORT=1433
GRE_FC_SQL_DATABASE=GRE_FORMULARIOS_TEST
GRE_FC_SQL_USER=USUARIO_MINIMO_GRE_FC
GRE_FC_SQL_PASSWORD=REEMPLAZAR
GRE_FC_SQL_ENCRYPT=false
GRE_FC_SQL_TRUST_SERVER_CERTIFICATE=true

# YCHIDB3 solo lectura
YCHI_SQL_SERVER=REEMPLAZAR
YCHI_SQL_PORT=1433
YCHI_SQL_DATABASE=YCHIDB3
YCHI_SQL_USER=USUARIO_SOLO_LECTURA_YCHI
YCHI_SQL_PASSWORD=REEMPLAZAR
YCHI_SQL_ENCRYPT=false
YCHI_SQL_TRUST_SERVER_CERTIFICATE=true

# Alias heredado aceptado por compatibilidad si aun no se renombro .env:
# YCHIDB3_SQL_SERVER=REEMPLAZAR
# YCHIDB3_SQL_PORT=1433
# YCHIDB3_SQL_DATABASE=YCHIDB3
# YCHIDB3_SQL_USER=USUARIO_SOLO_LECTURA_YCHI
# YCHIDB3_SQL_PASSWORD=REEMPLAZAR
# YCHIDB3_SQL_ENCRYPT=false
# YCHIDB3_SQL_TRUST_SERVER_CERTIFICATE=true

BIZLINKS_SQL_SERVER=REEMPLAZAR
BIZLINKS_SQL_PORT=1433
BIZLINKS_SQL_DATABASE=BIZLINKS_PROD21
BIZLINKS_SQL_USER=USUARIO_MINIMO_BIZLINKS
BIZLINKS_SQL_PASSWORD=REEMPLAZAR
BIZLINKS_SQL_ENCRYPT=false
BIZLINKS_SQL_TRUST_SERVER_CERTIFICATE=true
